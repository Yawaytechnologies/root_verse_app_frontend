{
  "expo": {
    "name": "OneBlue",
    "slug": "root_verse_app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rootverseapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets_images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets_images/icon.png",
        "backgroundColor": "#E6F4FE"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.yawaytech.root_verse_app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets_images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets_images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow RootVerse to access your camera to scan QR / barcodes."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e5921238-0ead-4847-8e2b-8f63727517e8"
      }
    },
    "owner": "janarthanan_m"
  }
}
